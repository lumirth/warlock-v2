{
  "name": "@uiuc-course-search/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "VITE_API_BASE_URL=https://uiuc-course-search-staging.lumirth.workers.dev npm run build && wrangler pages deploy dist --project-name uiuc-course-search-web --branch staging",
