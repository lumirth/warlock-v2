{
  "name": "@warlock-v2/web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "VITE_API_BASE_URL=https://warlock-staging.lumirth.workers.dev npm run build && wrangler pages deploy dist --project-name warlock-v2 --branch staging",
    "deploy:production": "VITE_API_BASE_URL=https://warlock.lumirth.workers.dev npm run build && wrangler pages deploy dist --project-name warlock-v2 --branch main",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@warlock-v2/query-types": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.11.4",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.127.1"
  },
  "version": "2.0.0-beta.1"
