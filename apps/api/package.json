{
  "name": "@uiuc-course-search/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "eval": "npx tsx src/eval/runner.ts",
    "eval:smoke": "tsx scripts/eval-smoke.ts",
    "check": "npm run typecheck && npm run test",
    "deploy:staging": "tsx ../../scripts/staging-api-release.ts",
    "deploy:production": "tsx ../../scripts/staging-api-release.ts --target production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@uiuc-course-search/query-types": "^0.0.1",
    "domhandler": "^5.0.3",
    "hono": "^4.12.32",
    "htmlparser2": "^10.0.0"
  }
}
