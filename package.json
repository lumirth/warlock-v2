{
  "name": "uiuc-course-search-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:subjects": "tsx scripts/generate-subjects.ts",
    "dev": "npm run generate:subjects && concurrently \"npm run dev -w @uiuc-course-search/api\" \"npm run dev -w @uiuc-course-search/web\"",
    "build": "npm run build --workspaces",
    "build:with-generated-subjects": "npm run generate:subjects && npm run build",
    "test": "npm test --workspaces && npm run test:scripts",
    "test:workspaces": "npm test --workspaces",
    "test:scripts": "vitest run scripts/__tests__",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:scripts",
    "typecheck:workspaces": "npm run typecheck --workspaces",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "bundle:budget": "tsx scripts/check-bundle-budget.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "d1:preflight": "tsx scripts/d1-backup-preflight.ts",
    "cloudflare:preflight": "tsx scripts/cloudflare-staging-preflight.ts",
    "bootstrap:fresh-check": "tsx scripts/verify-fresh-clone.ts",
    "db:verify": "bash scripts/verify-schema.sh",
    "eval:smoke": "tsx scripts/eval-smoke.ts",
    "eval:staging": "if [ -z \"$EVAL_BASE_URL\" ]; then echo \"EVAL_BASE_URL is required, for example https://api-staging.example.workers.dev\" >&2; exit 1; fi; npm run eval -w @uiuc-course-search/api -- \"$EVAL_BASE_URL\"",
    "test:staging": "tsx scripts/staging-smoke.ts",
    "qa:mock-api": "tsx scripts/browser-qa-mock-api.ts",
    "deploy:api": "npm run deploy -w @uiuc-course-search/api",
    "deploy:web": "npm run deploy -w @uiuc-course-search/web",
    "deploy": "concurrently \"npm run deploy:api\" \"npm run deploy:web\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  }
}
