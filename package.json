{
  "name": "uiuc-course-search-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @uiuc-course-search/api\" \"npm run dev -w @uiuc-course-search/web\"",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "deploy:api": "npm run deploy -w @uiuc-course-search/api",
    "deploy:web": "npm run deploy -w @uiuc-course-search/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
