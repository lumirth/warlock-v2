{
  "name": "warlock-v2",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @warlock-v2/api\" \"npm run dev -w @warlock-v2/web\"",
    "build": "npm run build --workspaces && npm run typecheck:scripts",
    "test": "npm test --workspaces && npm run test:scripts",
    "test:workspaces": "npm test --workspaces",
    "test:scripts": "vitest run scripts/__tests__",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:scripts",
    "typecheck:workspaces": "npm run typecheck --workspaces",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "bundle:budget": "tsx scripts/check-bundle-budget.ts",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "eval:staging": "if [ -z \"$EVAL_BASE_URL\" ]; then echo \"EVAL_BASE_URL is required, for example https://api-staging.example.workers.dev\" >&2; exit 1; fi; npm run eval -w @warlock-v2/api -- \"$EVAL_BASE_URL\"",
    "test:staging": "tsx scripts/smoke.ts",
    "test:production": "tsx scripts/smoke.ts --target production",
    "deploy:api:staging": "npm run deploy:staging -w @warlock-v2/api",
    "deploy:web:staging": "npm run deploy:staging -w @warlock-v2/web",
    "deploy:staging": "npm run deploy:api:staging && npm run deploy:web:staging",
    "deploy:api:production": "npm run deploy:production -w @warlock-v2/api",
    "deploy:web:production": "npm run deploy:production -w @warlock-v2/web",
    "deploy:production": "npm run deploy:api:production && npm run deploy:web:production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "sharp": "0.35.4",
    "undici": "7.29.1"
  },
  "version": "2.0.0-beta.1"
}
